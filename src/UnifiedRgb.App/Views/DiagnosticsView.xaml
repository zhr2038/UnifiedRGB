<UserControl x:Class="UnifiedRgb.App.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:UnifiedRgb.App.Views"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/UnifiedRgb.App;component/Themes/StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,22"><StackPanel><TextBlock Text="{Binding ClockChinese}" FontFamily="Consolas" FontSize="14"/><TextBlock Text="{Binding Uptime}" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel><Button Content="导出诊断包" Command="{Binding ExportCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><TextBlock Text="{Binding ExportResult}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding WriterCandidates}" Style="{StaticResource Caption}" FontSize="12"/><v:NativeToolsView DataContext="{Binding Bringup}"/></StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Margin="0,0,24,0"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Id, Converter={StaticResource ControllerLabel}}" TextWrapping="Wrap"/><TextBlock Text="{Binding State, Converter={StaticResource StateLabel}}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="24"><ScrollViewer><StackPanel>
                <TextBlock Text="{Binding SelectedName}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24"/>
                <Grid DataContext="{Binding SelectedDevice}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="实际发送帧率" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Fps, StringFormat=0.0}" FontFamily="Consolas" FontSize="30" Margin="0,8,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="累计写入" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Written}" FontFamily="Consolas" FontSize="30" Margin="0,8,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="丢帧" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Dropped}" FontFamily="Consolas" FontSize="30" Margin="0,8,0,0"/></StackPanel>
                </Grid>
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24"/>
                <StackPanel DataContext="{Binding SelectedDevice}">
                    <TextBlock Text="发送耗时 / 毫秒" Style="{StaticResource Caption}"/><TextBlock Margin="0,8,0,0"><Run Text="p50  "/><Run Text="{Binding FrameMsP50, Mode=OneWay, StringFormat=0.00}"/><Run Text="     p99  "/><Run Text="{Binding FrameMsP99, Mode=OneWay, StringFormat=0.00}"/></TextBlock>
                    <TextBlock Text="最近上传的无线动画" Style="{StaticResource FieldLabel}"/><TextBlock><Run Text="{Binding LastUpload.Frames, Mode=OneWay}"/><Run Text=" 帧    ·    "/><Run Text="{Binding LastUpload.CompressedBytes, Mode=OneWay}"/><Run Text=" 字节    ·    "/><Run Text="{Binding LastUpload.Packets, Mode=OneWay}"/><Run Text=" 个包"/></TextBlock>
                    <TextBlock Text="无线接收核对" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding LastUpload.ReceiverDelivery, Converter={StaticResource RfDeliveryLabel}}" TextWrapping="Wrap"/>
                    <TextBlock Text="安装映射" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding LastUpload.Mapping}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                    <TextBlock Text="几何与压缩" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding LastUpload.Geometry}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                    <TextBlock Text="{Binding LastUpload.Fidelity}" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                    <TextBlock Text="最近错误" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding LastError}" Foreground="#F0B58A" TextWrapping="Wrap"/>
                    <Expander Header="底层信息" Margin="0,24,0,0"><StackPanel><TextBlock Text="{Binding Id}" TextWrapping="Wrap"/><TextBlock Text="{Binding BlockedBy}" TextWrapping="Wrap"/><TextBlock Text="{Binding LastUpload.CodecSha256}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/></StackPanel></Expander>
                </StackPanel>
            </StackPanel></ScrollViewer></Border>
        </Grid>
    </DockPanel>
</UserControl>



