<UserControl x:Class="UnifiedRgb.App.Views.ProfilesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:UnifiedRgb.App.Views"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/UnifiedRgb.App;component/Themes/StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="已保存场景" Command="{Binding ShowSavedCommand}" Margin="0,0,10,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding LibraryPage}" Value="0"><Setter Property="Background" Value="#183B39"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="#B7FFF1"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Content="外部场景包" Command="{Binding ShowPackagesCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding LibraryPage}" Value="1"><Setter Property="Background" Value="#183B39"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="#B7FFF1"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        </StackPanel>
    <Grid Grid.Row="1" Visibility="{Binding LibraryPage, Converter={StaticResource PageVisible}, ConverterParameter=0}" TextElement.Foreground="{StaticResource TextBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,26,0"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="已保存场景" Style="{StaticResource SectionTitle}"/><Button Content="刷新场景库" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Style="{StaticResource QuietButton}"/></StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><TextBlock Text="把当前运行状态保存为新场景" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新场景名称"/><Button Content="保存当前场景" Command="{Binding SaveCommand}" Margin="0,8,0,0"/></StackPanel>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name, Converter={StaticResource SceneLabel}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Modified, StringFormat='yyyy/MM/dd  HH:mm'}" Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        </DockPanel>
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="30"><DockPanel>
            <StackPanel DockPanel.Dock="Top"><Border Height="4" Background="{Binding SelectedColor, Converter={StaticResource HexBrush}}" CornerRadius="2" Margin="0,0,0,28"/><TextBlock Text="{Binding SelectedTitle}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedModified}" Style="{StaticResource Caption}" Margin="0,12,0,0"/><TextBlock Text="{Binding Details}" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,24"/></StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0"><TextBlock Text="应用场景会替换对应灯效；含屏幕内容的场景会同时切换屏幕。" Style="{StaticResource Caption}" Margin="0,0,0,14"/><Button Content="应用此场景" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="28,10"/></StackPanel>
            <ScrollViewer><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="25" Foreground="{StaticResource MutedBrush}"/></ScrollViewer>
        </DockPanel></Border>
    </Grid>
    <v:ScenePackagesView Grid.Row="1" DataContext="{Binding Packages}" Visibility="{Binding DataContext.LibraryPage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PageVisible}, ConverterParameter=1}"/></Grid>
</UserControl>


