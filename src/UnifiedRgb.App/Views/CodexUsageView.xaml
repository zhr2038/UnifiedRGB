<UserControl x:Class="UnifiedRgb.App.Views.CodexUsageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/UnifiedRgb.App;component/Themes/StudioTheme.xaml" />
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="0,0,12,0" MaxWidth="720" HorizontalAlignment="Stretch">
   <TextBlock Text="Codex" FontSize="20" FontWeight="SemiBold" />
   <TextBlock Text="键盘独立页面 · 额度预览" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,8" />
   <Border Background="Black" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8" MaxWidth="432" HorizontalAlignment="Left">
    <Viewbox Stretch="Uniform">
     <Grid Width="208" Height="64" AutomationProperties.Name="Codex 原生额度布局预览">
      <ItemsControl ItemsSource="{Binding PreviewWindows, Mode=OneWay}" VerticalAlignment="Center">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <StackPanel Margin="4,1">
          <Grid Height="18">
           <ProgressBar Value="{Binding RemainingPercent, Mode=OneWay}" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="#303030" AutomationProperties.Name="剩余额度百分比" />
           <TextBlock Text="{Binding RemainingPercent, Mode=OneWay, StringFormat={}{0:0.#}%}" Foreground="Black" Background="{StaticResource TextBrush}" Padding="3,0" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding ResetsAt, Mode=OneWay, StringFormat=重置 {0:MM-dd HH:mm}}" Foreground="White" FontSize="9" />
         </StackPanel>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </Grid>
    </Viewbox>
   </Border>
   <TextBlock Text="用键盘切页键进入 Codex：先显示标志和名称，再显示剩余额度与重置时间。机箱熄灯时也可以查看。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
   <TextBlock Text="在 Codex 页按下拨杆，可打开电脑上的 Codex。光域页继续使用原来的场景图案与控制。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
   <WrapPanel Margin="0,14,0,8">
    <Button Content="开启 Codex 页" Command="{Binding ShowCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,6" />
    <Button Content="停止显示" Command="{Binding StopCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,6" />
    <Button Content="刷新状态" Command="{Binding ReadCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,6" />
   </WrapPanel>
   <TextBlock Text="{Binding Summary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.Name="Codex 配额数据" />
   <TextBlock Text="{Binding OpenActionStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.Name="Codex 打开操作状态" Margin="0,8,0,0" />
   <TextBlock Text="{Binding Message, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
