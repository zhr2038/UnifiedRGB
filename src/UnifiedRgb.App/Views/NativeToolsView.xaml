<UserControl x:Class="UnifiedRgb.App.Views.NativeToolsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/UnifiedRgb.App;component/Themes/StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/></ResourceDictionary></UserControl.Resources>        <Expander  Header="原生硬件校验 · 高级" Margin="0,6,0,0" >
            <ScrollViewer MaxHeight="320"><StackPanel Margin="4">
                <TextBlock Text="此处用于通信探测和灯位校验。通信成功不等于实机效果已确认；每一步都需要主动执行，校验会话属于当前连接。"
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="目标" Width="60" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label" Width="380" />
                    <TextBlock Text="租期 / 秒" Margin="12,0,4,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding LeaseSeconds}" Width="50" ToolTip="15 to 600 s; renewed by this window while the session runs" />
                    <Button Content="开始会话" Command="{Binding BeginCommand}" Padding="12,2" Margin="8,0,0,0" />
                    <Button Content="续期" Command="{Binding RenewCommand}" Padding="12,2" Margin="6,0,0,0" />
                    <Button Content="结束会话" Command="{Binding EndCommand}" Padding="12,2" Margin="6,0,0,0" />
                </WrapPanel>
                <TextBlock Text="{Binding TargetText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SessionText}" Margin="0,2,0,0" />
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="探测" Width="60" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Probes}" SelectedItem="{Binding SelectedProbe}" Width="200" />
                    <Button Content="执行探测" Command="{Binding RunProbeCommand}" Padding="12,2" Margin="8,0,0,0" />
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="灯位标记" Width="60" VerticalAlignment="Center" />
                    <TextBlock Text="起点" VerticalAlignment="Center" />
                    <TextBox Text="{Binding MarkerStart}" Width="45" Margin="4,0,0,0" />
                    <Button Content="&#x25C0;" Command="{Binding StepBackCommand}" Width="28" Margin="4,0,0,0" ToolTip="Previous range (nothing is sent)" />
                    <Button Content="&#x25B6;" Command="{Binding StepForwardCommand}" Width="28" Margin="2,0,0,0" ToolTip="Next range (nothing is sent)" />
                    <TextBlock Text="数量" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding MarkerCount}" Width="40" Margin="4,0,0,0" />
                    <TextBlock Text="通道" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding MarkerChannel}" Width="45" Margin="4,0,0,0"
                             ToolTip="Aura: 0 onboard, 1..n ARGB header. ENE port target: the controller's SMBus address in decimal (112 = 0x70). Otherwise 0." />
                    <TextBlock Text="颜色" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding MarkerColor}" Width="70" Margin="4,0,0,0" IsEnabled="{Binding CanEditColor}" />
                    <Button Content="发送标记" Command="{Binding MarkerCommand}" Padding="12,2" Margin="8,0,0,0" />
                    <Button Content="结束标记并熄灭" Command="{Binding EndMarkerCommand}" Padding="12,2" Margin="6,0,0,0" />
                </WrapPanel>
                <TextBlock Text="黑场保护已开启：只允许黑色标记。" Foreground="{StaticResource MutedBrush}"
                           Visibility="{Binding HoldBlack, Converter={StaticResource Visible}}" />
                <ListBox ItemsSource="{Binding Results}" Height="120" Margin="0,4,0,0" FontFamily="Consolas" />
            </StackPanel>
        </ScrollViewer></Expander></UserControl>



