<UserControl x:Class="UnifiedRgb.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/UnifiedRgb.App;component/Themes/StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <ScrollViewer><StackPanel MaxWidth="800" HorizontalAlignment="Left">
        <TextBlock Text="桌面与启动" Style="{StaticResource SectionTitle}"/><CheckBox Content="登录 Windows 后启动光域，最小化到托盘" IsChecked="{Binding StartWithWindows}"/>
        <TextBlock Text="关闭窗口后继续在托盘运行，机箱灯效由后台服务保持。可在托盘菜单中退出界面。" Style="{StaticResource Caption}" Margin="24,7,0,0"/>
        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,32"/>
        <TextBlock Text="后台配置" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="主时钟帧率" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding FrameRate}"/></Grid>
        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="日志" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding LogLevels}" TextWrapping="Wrap"/></Grid>
        <TextBlock Text="后台帧率、驱动和设备输出门槛由后台配置管理。界面不会为修改这些设置自动请求管理员权限。" Style="{StaticResource Caption}" Margin="0,22,0,0"/>
        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,32"/>
        <TextBlock Text="关于光域" Style="{StaticResource SectionTitle}"/>
        <StackPanel Orientation="Horizontal"><Image Source="{StaticResource Brand.Logo}" Width="64" Height="64" Margin="0,0,18,0" IsHitTestVisible="False" AutomationProperties.Name="光域标志"/><StackPanel VerticalAlignment="Center"><TextBlock Text="光域" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="全机灯光与屏幕内容控制台" FontSize="16" Margin="0,5,0,0"/></StackPanel></StackPanel>
        <TextBlock Text="原生设备接入 · 共享场景 · 统一编排" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
    </StackPanel></ScrollViewer>
</UserControl>


