<UserControl x:Class="UnifiedRgb.App.Views.ScenePackagesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:UnifiedRgb.App.Views" Foreground="{DynamicResource TextBrush}" Validation.Error="InputValidation">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/UnifiedRgb.App;component/Themes/StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel LastChildFill="True" Margin="0,0,0,14">
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="另存为场景" Command="{Binding SaveVariantCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="应用到机箱" Command="{Binding ApplyEditsCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding EditorDraftState}" Foreground="{StaticResource AccentBrush}" FontSize="12"/><TextBlock Text="{Binding Provenance}" Style="{StaticResource Caption}" FontSize="10"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="230"/><ColumnDefinition Width="16"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
   <DockPanel Background="{StaticResource SurfaceBrush}">
    <StackPanel DockPanel.Dock="Top" Margin="14,16,14,12"><TextBlock Text="外部场景" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/><Button Content="＋ 导入效果包" Command="{Binding ImportCommand}" Style="{StaticResource QuietButton}"/><TextBlock Text="{Binding Usage}" Style="{StaticResource Caption}" FontSize="10" Margin="0,10,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,16"><Button Content="刷新场景" Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}"/><Button Content="开发规范与示例" Command="{Binding OpenDeveloperDocsCommand}" Style="{StaticResource QuietButton}" Margin="0,6,0,0"/><TextBlock Text="原始包保留，调参保存为独立版本。" Style="{StaticResource Caption}" FontSize="11" Margin="0,12,0,0"/></StackPanel>
    <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanSelect}" Margin="8,0" AutomationProperties.Name="外部场景列表"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="10" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="140"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14"><TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    <Border Grid.Row="1" CornerRadius="12" Background="#050505" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True"><Grid><v:PackageCasePreview/><TextBlock Text="选择一个场景包，读取原始帧预演" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasDynamicPreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
    <StackPanel Grid.Row="2" Margin="0,12,0,0"><WrapPanel><Button Content="{Binding PreviewButtonText}" Command="{Binding TogglePreviewCommand}" Style="{StaticResource QuietButton}" FontSize="11" Padding="12,6" MinHeight="30"/><Button Content="回到开头" Command="{Binding PreviewStartCommand}" Style="{StaticResource QuietButton}" FontSize="11" Padding="10,6" MinHeight="30" Margin="6,0,10,0"/><TextBlock Text="{Binding PreviewTime}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/></WrapPanel><Slider Minimum="0" Maximum="{Binding PreviewDurationMs}" Value="{Binding PreviewPositionMs, Mode=TwoWay}" Margin="0,8,0,0" AutomationProperties.Name="本地预演时间轴"/><TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Caption}" FontSize="10" Margin="0,6,0,0"/></StackPanel>
    <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0"><ScrollViewer MaxHeight="74"><TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="11"/></ScrollViewer></Border>
   </Grid>
   <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" Padding="18,14">
    <TabControl SelectedIndex="{Binding InspectorPage}" Background="Transparent" BorderThickness="0">
     <TabItem Header="内容"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,14,8,0" IsEnabled="{Binding CanAdjust}">
      <TextBlock Text="播放与画面" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Style="{StaticResource FieldLabel}"><Run Text="灯光亮度"/><Run Text="{Binding LightingBrightness, StringFormat='  {0:0}%'}"/></TextBlock><Slider Minimum="0" Maximum="100" Value="{Binding LightingBrightness}" AutomationProperties.Name="外部效果灯光亮度"/>
      <TextBlock Text="整体播放速度" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding SpeedChoices}" SelectedItem="{Binding PlaybackSpeed}" ItemStringFormat="{}{0:0.##}×" AutomationProperties.Name="外部效果播放速度"/>
      <TextBlock Text="速度与反向作用于同组灯光和屏幕。" Style="{StaticResource Caption}" FontSize="10" Margin="0,6,0,0"/>
      <TextBlock Style="{StaticResource FieldLabel}"><Run Text="灯光色相偏移"/><Run Text="{Binding HueDegrees, StringFormat='  {0:0}°'}"/></TextBlock><Slider Minimum="-180" Maximum="180" Value="{Binding HueDegrees}" AutomationProperties.Name="灯光色相偏移"/>
      <CheckBox Content="反向播放整组内容" IsChecked="{Binding PlaybackReverse}" Margin="0,12,0,0"/><CheckBox Content="启用灯光内容" IsChecked="{Binding LightingEnabled}" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding ParameterProblem}" Foreground="#F0B58A" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
      <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,16"/>
      <TextBlock Text="角色与屏幕内容" FontSize="14" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Label" Margin="0,10,0,0" AutomationProperties.Name="选择内容角色"/>
      <StackPanel DataContext="{Binding SelectedRole}" Margin="0,10,0,0"><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="10"/>
       <StackPanel Visibility="{Binding ShowScreenEditor, Converter={StaticResource Visible}}">
        <TextBlock Text="屏幕画面亮度 / %" Style="{StaticResource FieldLabel}"/><Slider Minimum="0" Maximum="100" Value="{Binding ScreenBrightness}"/>
        <TextBlock Text="监控叠层" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DataContext.ScreenOverlays, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ScreenOverlay}"/>
        <TextBlock Text="画面适配" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DataContext.ScreenFits, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ScreenFit}"/>
        <TextBlock Text="信息强调色" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ScreenAccent, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="目标发送上限 / fps" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ScreenFps, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
        <TextBlock Text="发送上限不等于可见帧率。" Style="{StaticResource Caption}" FontSize="10" Margin="0,5,0,0"/><CheckBox Content="启用此屏幕" IsChecked="{Binding ScreenEnabled}" Margin="0,10,0,0"/>
        <Expander Header="监控区域" Margin="0,14,0,0" IsEnabled="{Binding AllowsRegion}"><StackPanel Margin="0,10,0,0"><CheckBox Content="指定监控区域" IsChecked="{Binding UseRegion}"/>
         <UniformGrid Columns="2" Margin="0,8,0,0"><StackPanel Margin="0,0,6,8"><TextBlock Text="左 / %" Style="{StaticResource Caption}"/><TextBox Text="{Binding RegionX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="上 / %" Style="{StaticResource Caption}"/><TextBox Text="{Binding RegionY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel><StackPanel Margin="0,0,6,8"><TextBlock Text="宽 / %" Style="{StaticResource Caption}"/><TextBox Text="{Binding RegionWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="高 / %" Style="{StaticResource Caption}"/><TextBox Text="{Binding RegionHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel></UniformGrid>
         <TextBlock Text="列数 / 1～4" Style="{StaticResource Caption}"/><TextBox Text="{Binding RegionColumns, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="背景不透明度 / %" Style="{StaticResource FieldLabel}"/><Slider Minimum="0" Maximum="100" Value="{Binding RegionOpacity}"/>
        </StackPanel></Expander>
       </StackPanel>
      </StackPanel>
      <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,14"/><Button Content="保存参数与绑定" Command="{Binding SaveEditsCommand}" Style="{StaticResource QuietButton}"/><Button Content="恢复原始参数" Command="{Binding ResetEditsCommand}" Style="{StaticResource QuietButton}" Margin="0,6,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="设备绑定"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,8,0"><TextBlock Text="每个角色对应一个本机设备。" Style="{StaticResource Caption}" FontSize="11"/><ItemsControl ItemsSource="{Binding Roles}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,12,0,6"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="10" Margin="0,3,0,6"/><ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" AutomationProperties.Name="{Binding Label}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="保存参数与绑定" Command="{Binding SaveEditsCommand}" Margin="0,16,0,0"/><Button Content="保存绑定（兼容后台）" Command="{Binding SaveBindingsCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/><TextBlock Text="{Binding BindingStatus}" Foreground="{StaticResource AccentBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem>
     <TabItem Header="版本"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,8,0"><TextBlock Text="另存为场景" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding VariantName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="自定义场景名称"/><Button Content="另存为场景" Command="{Binding SaveVariantCommand}" Margin="0,8,0,18"/><TextBlock Text="已保存参数版本" Style="{StaticResource SectionTitle}"/><ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" MaxHeight="220"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding SavedAt, StringFormat='{}{0:MM-dd HH:mm:ss}'}" FontSize="12"/><TextBlock Text="{Binding BindingId}" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Playback.Speed, StringFormat='速度 {0:0.##}×'}" Style="{StaticResource Caption}" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="载入为草稿" Command="{Binding LoadVersionCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,16"/><TextBlock Text="原始包和保存记录均独立保留。" Style="{StaticResource Caption}" FontSize="11"/><Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,14"/><Button Content="删除此包…" Command="{Binding RemoveCommand}" Style="{StaticResource QuietButton}"/><CheckBox Content="同时清理无引用素材" IsChecked="{Binding CleanRelatedMedia}" Margin="0,10,0,0"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Border>
  </Grid>
 </Grid>
</UserControl>
