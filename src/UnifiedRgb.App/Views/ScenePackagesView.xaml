<UserControl x:Class="UnifiedRgb.App.Views.ScenePackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/UnifiedRgb.App;component/Themes/StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,22,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="已安装场景包" Style="{StaticResource SectionTitle}"/>
                <WrapPanel><Button Content="导入场景包" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel>
                <TextBlock Text="选择 ZIP 文件，内容会独立保存在本机。" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding Usage}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><Button Content="开发规范与示例" Command="{Binding OpenDeveloperDocsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="导入和预览不会切换当前灯光或屏幕。" Style="{StaticResource Caption}"/></StackPanel>
            <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="已安装场景包">
                <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Provenance}" Style="{StaticResource Caption}" FontSize="11" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <TextBlock Text="{Binding BindingStatus}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" Visibility="{Binding HasDetails, Converter={StaticResource Visible}}"/>
                    <ScrollViewer MaxHeight="100" Margin="0,0,0,12"><TextBlock Text="{Binding Message}" Style="{StaticResource Caption}"/></ScrollViewer>
                    <WrapPanel>
                        <Button Content="保存设备绑定" Command="{Binding SaveBindingsCommand}" Style="{StaticResource QuietButton}" Margin="0,0,10,6"/>
                        <Button Content="应用场景包" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="删除此包…" Command="{Binding RemoveCommand}" Style="{StaticResource QuietButton}" Margin="0,0,12,6"/>
                        <CheckBox Content="清理无引用素材" IsChecked="{Binding CleanRelatedMedia}" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}" ToolTip="同时清理同源且未被当前播放、其他包或保存场景引用的屏幕素材；包含相同文件单独上传的缓存。外部原文件保持不变。"/>
                    </WrapPanel>
                </StackPanel>
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="内容首帧与设备绑定" Style="{StaticResource SectionTitle}" Visibility="{Binding HasDetails, Converter={StaticResource Visible}}"/>
                        <ItemsControl ItemsSource="{Binding Roles}" IsEnabled="{Binding CanEdit}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                                        <ItemsControl ItemsSource="{Binding Colors}" Margin="0,10,0,5" ClipToBounds="True">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><Border Width="9" Height="14" Margin="0,0,1,2" Background="{Binding Converter={StaticResource HexBrush}}"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Caption}" FontSize="11"/>
                                        <Image Source="{Binding Preview}" Height="82" MaxWidth="328" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,5,0,8"><Image.Style><Style TargetType="Image"><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Image.Style></Image>
                                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" AutomationProperties.Name="{Binding Label}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
