<UserControl x:Class="UnifiedRgb.App.Views.WorkbenchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:UnifiedRgb.App.Views">
 <TabControl SelectedIndex="{Binding WorkbenchSourceIndex}" Background="Transparent" BorderThickness="0">
  <TabItem Header="内置灯效"><v:LightingStudioView DataContext="{Binding Studio}" Margin="0,10,0,0"/></TabItem>
  <TabItem Header="外部导入"><v:ScenePackagesView DataContext="{Binding Packages}" Margin="0,10,0,0"/></TabItem>
 </TabControl>
</UserControl>
