<UserControl x:Class="UnifiedRgb.App.Views.EffectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:UnifiedRgb.App.Preview">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/UnifiedRgb.App;component/Themes/StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="Vis" />
    </ResourceDictionary></UserControl.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <GroupBox Header="Zones">
            <ListBox ItemsSource="{Binding Zones}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <StackPanel Visibility="{Binding ShowFamilyModes, Converter={StaticResource Vis}}" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Lian Li family" Width="100" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding Family}" Width="120" />
                <TextBlock Text="Mode" Margin="12,0,6,0" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding FamilyModes}" SelectedItem="{Binding FamilyMode}" DisplayMemberPath="Label" Width="180" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Effect" Width="100" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}" DisplayMemberPath="DisplayName" Width="200" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Colors" Width="100" VerticalAlignment="Top" />
                <ItemsControl ItemsSource="{Binding Colors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,6,4">
                                <TextBox Text="{Binding Hex, UpdateSourceTrigger=LostFocus}" Width="70" />
                                <Button Content="×" Width="20"
                                        Command="{Binding DataContext.RemoveColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+" Width="24" Command="{Binding AddColorCommand}" VerticalAlignment="Top" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding UsesSpeed, Converter={StaticResource Vis}}">
                <TextBlock Text="Speed" Width="100" />
                <Slider Minimum="0" Maximum="1" Value="{Binding Speed}" Width="240" TickFrequency="0.25" TickPlacement="BottomRight"
                        IsSnapToTickEnabled="{Binding SnapVendorSpeed}"
                        ToolTip="Under L-Connect loop bodies the vendor has five speed steps (0/25/50/75/100 %); the slider snaps to them." />
                <TextBlock Text="{Binding VendorSpeedText}" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Brightness" Width="100" />
                <Slider Minimum="0" Maximum="1" Value="{Binding Brightness}" Width="240" />
            </StackPanel>
            <CheckBox Content="Reverse direction" IsChecked="{Binding Reverse}" Margin="100,0,0,6"
                      Visibility="{Binding UsesDirection, Converter={StaticResource Vis}}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding ShowStrategy, Converter={StaticResource Vis}}">
                <TextBlock Text="Content" Width="100" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}" Width="120"
                          ToolTip="路径循环：光域数学内容与设备路径投影。程序生成：通用生成器。旧场景的 Vendor 标识继续兼容。" />
            </StackPanel>
            <TextBlock Text="{Binding LoopSummary}" Margin="100,0,0,6" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="Preview" Margin="0,6,0,2" />
            <p:ZonePreviewControl Renderer="{Binding Preview}" Height="96" />
            <Button Content="Apply to selected zones" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Padding="12,2" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>


