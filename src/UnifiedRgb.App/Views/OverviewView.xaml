<UserControl x:Class="UnifiedRgb.App.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:w="clr-namespace:UnifiedRgb.App.Workbench">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/UnifiedRgb.App;component/Themes/StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="24,22,24,0"><TextBlock Text="机箱布局" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="安装布局示意" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel>
   <w:CaseTopology Grid.Row="1" Zones="{Binding Zones}" SelectedZone="{Binding SelectedZone}" ColorHex="{Binding Draft.PrimaryColor}" Playing="{Binding PreviewPlaying}" Draft="{Binding Draft}" MinHeight="160" Margin="8,12"/>
   <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="24,0" Padding="0,16"><WrapPanel><Button Content="{Binding PreviewButton}" Command="{Binding PreviewCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,6"/><Button Content="灯光编排" Command="{Binding NavigateCommand}" CommandParameter="1" Style="{StaticResource QuietButton}" Margin="0,0,8,6"/><Button Content="机箱屏幕" Command="{Binding NavigateCommand}" CommandParameter="2" Style="{StaticResource QuietButton}" Margin="0,0,0,6"/></WrapPanel></Border>
  </Grid></Border>
  <ScrollViewer Grid.Column="2"><StackPanel Margin="0,4,10,0">
   <TextBlock Text="当前编排" Style="{StaticResource Caption}" FontSize="12"/><TextBlock Text="{Binding Draft.NameLabel}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,8"/><TextBlock Text="{Binding SceneDescription}" Style="{StaticResource Caption}"/><Button Content="打开场景库" Command="{Binding NavigateCommand}" CommandParameter="4" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
   <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24"/><TextBlock Text="{Binding PeriodTitle}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Period}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="30" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="设备时间轴模型 · 实际观感以机箱为准" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0"/>
   <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24"/><TextBlock Text="键盘与鼠标" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="显示与动画、拨杆联动、外设配置" Style="{StaticResource Caption}" Margin="0,8,0,12"/><Button Content="管理键盘与鼠标" Command="{Binding NavigateCommand}" CommandParameter="7" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
   <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24"/><DockPanel><TextBlock Text="{Binding SelectedName}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Zones.Count, StringFormat={}{0} 个分区}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource Caption}" FontSize="12" Margin="0,10,0,0"/>
   <ListBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" Margin="0,12,0,0" MaxHeight="220" AutomationProperties.Name="机箱分区"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="12" Margin="0,20,0,12"/>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
