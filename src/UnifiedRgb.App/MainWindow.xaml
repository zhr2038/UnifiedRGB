<Window x:Class="UnifiedRgb.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:v="clr-namespace:UnifiedRgb.App.Views" xmlns:w="clr-namespace:UnifiedRgb.App.Workbench"
 Title="光域 · 机箱控制台" Width="1460" Height="940" Icon="/UnifiedRgb.App;component/Assets/Brand/guangyu.ico"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Language="zh-CN">
 <Window.Resources>
  <v:ScreenShellCompactConverter x:Key="ScreenPilot.CompactShell"/>
  <Style x:Key="ScreenPilot.ShellSecondary" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource ScreenPilot.CompactShell}"><Binding Path="DataContext.Studio.Page" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></DataTrigger.Binding><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="Shell.NavItem" TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="14,12"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="NavBody" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="2,0,0,0" BorderBrush="Transparent" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBody" Property="Background" Value="{StaticResource RaisedBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBody" Property="Background" Value="#2A241B"/><Setter TargetName="NavBody" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBody" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding StartsSection}" Value="True"><Setter Property="Margin" Value="0,22,0,2"/></DataTrigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Window.Style><Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}"><Setter Property="MinWidth" Value="1000"/><Setter Property="MinHeight" Value="560"/><Style.Triggers><DataTrigger Binding="{Binding Studio.Page}" Value="2"><Setter Property="MinWidth" Value="800"/><Setter Property="MinHeight" Value="480"/></DataTrigger></Style.Triggers></Style></Window.Style>
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource CanvasBrush}"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="#080808" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid>
   <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center"><Image Source="{StaticResource Brand.Mark}" Width="20" Height="20" Margin="0,0,10,0" IsHitTestVisible="False" AutomationProperties.Name="光域标志"/><TextBlock Text="光域" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="LIGHT CONTROL" Foreground="{StaticResource MutedBrush}" FontFamily="Segoe UI" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="46" MinHeight="36" Style="{StaticResource QuietButton}" Click="MinimizeClick" AutomationProperties.Name="最小化"/><Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="46" MinHeight="36" Style="{StaticResource QuietButton}" Click="MaximizeClick" AutomationProperties.Name="最大化或还原"/><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="46" MinHeight="36" Style="{StaticResource QuietButton}" Click="CloseClick" AutomationProperties.Name="隐藏到托盘"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#090909" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="16,24,16,18">
    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,24" Style="{StaticResource ScreenPilot.ShellSecondary}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Brand.Logo}" Width="38" Height="38" Margin="0,0,10,0" IsHitTestVisible="False"/><TextBlock Text="光域" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="创作与控制" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,24,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="12,18,8,0" Style="{StaticResource ScreenPilot.ShellSecondary}"><Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,16"/><TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Studio.Health}" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxHeight="42" ToolTip="{Binding Studio.Health}"/><Button Content="{Binding HostStart.Label}" Command="{Binding HostStart.StartCommand}" Visibility="{Binding HostStart.IsOffered, Converter={StaticResource Visible}}" Style="{StaticResource RecoveryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="{Binding HostStart.Label}"/><TextBlock Text="{Binding HostStart.Status}" Visibility="{Binding HostStart.HasStatus, Converter={StaticResource Visible}}" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
    <ListBox x:Name="MainNavigation" ItemsSource="{x:Static w:ShellNavigation.Pages}" SelectedValuePath="Page" SelectedValue="{Binding Studio.Page, Mode=TwoWay}" ItemContainerStyle="{StaticResource Shell.NavItem}" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="主导航">
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Margin="24,0" Padding="0,20,0,18"><DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Style="{StaticResource ScreenPilot.ShellSecondary}" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"><Button Content="刷新" Style="{StaticResource QuietButton}" Command="{Binding RefreshCommand}"/><Button Content="全机熄灯" Command="{Binding Studio.BlackoutCommand}" Margin="8,0,0,0"/><Button Content="恢复" Style="{StaticResource QuietButton}" Command="{Binding Studio.RestoreCommand}" Margin="8,0,0,0"/></StackPanel>
     <StackPanel><TextBlock Text="{Binding Studio.PageTitle}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding Studio.PageSubtitle}" Style="{StaticResource ScreenPilot.ShellSecondary}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
    </DockPanel></Border>
    <Grid Grid.Row="1" Margin="24,20,24,20" x:Name="PageHost">
     <v:OverviewView DataContext="{Binding Studio}" Visibility="{Binding DataContext.Studio.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=0}"/>
     <v:WorkbenchView Visibility="{Binding DataContext.Studio.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=1}"/>
     <v:ScreenWorkspaceView DataContext="{Binding Screens}" Visibility="{Binding DataContext.Studio.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=2}"/>
     <v:DevicesView DataContext="{Binding Devices}" Visibility="{Binding DataContext.Studio.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=3}"/>
     <v:ProfilesView DataContext="{Binding Profiles}" Visibility="{Binding DataContext.Studio.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=4}"/>
     <v:DiagnosticsView DataContext="{Binding Diagnostics}" Visibility="{Binding DataContext.Studio.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=5}"/>
     <v:SettingsView DataContext="{Binding Settings}" Visibility="{Binding DataContext.Studio.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=6}"/>
     <v:CaseControlPanelView DataContext="{Binding Studio.ControlPanel}" Visibility="{Binding DataContext.Studio.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=7}"/>
    </Grid>
    <Border Grid.Row="2" Background="#2A2018" Padding="18,10" Margin="28,0,28,14"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Studio.Page}" Value="2"/><Condition Binding="{Binding Screens.HasError}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button Content="关闭提示" Command="{Binding DismissErrorCommand}" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" Margin="16,0,0,0"/><StackPanel><TextBlock Text="上次操作未完成" Foreground="#F0B58A" FontWeight="SemiBold"/><TextBlock Text="{Binding Error}" Foreground="#F0B58A" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#080808" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,0"><DockPanel LastChildFill="False" VerticalAlignment="Center"><TextBlock Text="{Binding Studio.Updated}" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Studio.Written}" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Studio.Clock}" FontSize="11" FontFamily="Consolas" Margin="0,0,24,0" Foreground="{StaticResource MutedBrush}"/></DockPanel></Border>
  <Border x:Name="FaultNotice" Grid.Row="1" Panel.ZIndex="100" Visibility="Collapsed" VerticalAlignment="Top" Margin="24" Padding="18,14" CornerRadius="8" Background="#351E29" BorderBrush="#D87A98" BorderThickness="1" AutomationProperties.LiveSetting="Assertive">
            <StackPanel><TextBlock Text="界面需要重启" Foreground="#FFF2F5" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="FaultNoticeText" Foreground="#FFF2F5" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        </Border>
 </Grid></Border>
</Window>
