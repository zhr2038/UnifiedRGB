<Window x:Class="UnifiedRgb.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="光域 · 设备配置" Width="1060" Height="780" MinWidth="820" MinHeight="600" Background="#121923" FontFamily="Microsoft YaHei UI" FontSize="14" Loaded="OnLoaded">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="配置这台电脑" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="硬件识别、输出授权与物理验证分别记录。配置程序不会发送灯光、屏幕内容或更改风扇转速。" Foreground="#AEBCCE" Margin="0,8,0,20"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
      <RadioButton x:Name="Demo" Content="演示模式 · 不连接硬件" Foreground="#EAF0F8" IsChecked="True" Margin="0,0,24,0"/>
      <RadioButton x:Name="Hardware" Content="使用本机硬件" Foreground="#EAF0F8"/>
    </StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Families">
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="#344255" BorderThickness="0,0,0,1" Padding="0,14">
            <StackPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" ToolTip="{Binding TechnicalDetail}" Foreground="#AEBCCE" Margin="0,5,0,10"/>
              <StackPanel Orientation="Horizontal"><CheckBox Content="启用与发现" IsChecked="{Binding Enable}" IsEnabled="{Binding CanEnable}"/><CheckBox Content="授权输出（仍须完成设备验证）" IsChecked="{Binding Authorize}" IsEnabled="{Binding CanAuthorize}"/></StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <ScrollViewer Grid.Row="3" MaxHeight="120" Margin="0,18,0,18" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Status" Foreground="#FFD58A" Text="准备检查。"/></ScrollViewer>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="InspectButton" Content="重新检查" Click="OnInspect"/>
      <Button x:Name="SaveButton" Content="预览并保存配置" Click="OnSave"/>
      <Button x:Name="CloseButton" Content="关闭" Click="OnClose"/>
    </StackPanel>
  </Grid>
</Window>
