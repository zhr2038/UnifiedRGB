<Application x:Class="UnifiedRgb.Setup.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0F8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF0F8"/><Setter Property="Margin" Value="0,0,14,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
  </Application.Resources>
</Application>
